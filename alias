# shell
alias ls='ls -G'
alias la='ls -lAh'
alias s='cd ..'
alias vi="nvim"

# git https://github.com/ohmyzsh/ohmyzsh/blob/master/plugins/git/README.md
alias ga='git add'
alias gaa='git add -A'
alias gb='git add b'
alias gc='git commit'
alias gca='git commit --amend'
alias gcm='git commit --message'
alias gco='git checkout'
alias gd='git diff'
alias gdd='git -c diff.external=difft diff'
alias gme='git lg --author="$(git config user.name)"'
alias gl='git pull'
alias glo="git log --graph --pretty='%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ad) %C(bold blue)<%an>%Creset' --date=short"
alias glols="git log --graph --pretty='%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset' --stat"
alias glr='git pull --rebase'
alias gp='git push'
alias gpf='git push --force-with-lease'
alias gs='git status'
alias gsh='git show'
alias gshh='git -c diff.external=difft show --ext-diff'

# android
alias ss='adb exec-out screencap -p > ~/Desktop/screenshot-"$( date +%Y.%m.%d-%H.%M.%S )".png'

